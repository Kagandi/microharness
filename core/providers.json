{
  "google": {
    "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai",
    "default_model": "gemini-2.5-flash",
    "env_keys": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
    "reasoning_format": "standard",
    "cache_strategy": "implicit"
  },
  "openrouter": {
    "endpoint": "https://openrouter.ai/api/v1",
    "default_model": "anthropic/claude-5.5-sonnet",
    "env_keys": ["OPENROUTER_API_KEY"],
    "headers": {
      "HTTP-Referer": "https://github.com/microharness",
      "X-Title": "microharness"
    },
    "reasoning_format": "openrouter",
    "cache_strategy": "anthropic_block"
  },
  "openai": {
    "endpoint": "https://api.openai.com/v1",
    "default_model": "gpt-4o",
    "env_keys": ["OPENAI_API_KEY"],
    "reasoning_format": "standard",
    "cache_strategy": "implicit"
  },
  "anthropic": {
    "endpoint": "https://api.anthropic.com/v1",
    "default_model": "claude-5.5-sonnet",
    "env_keys": ["ANTHROPIC_API_KEY"],
    "headers": {
      "anthropic-version": "2023-06-01"
    },
    "reasoning_format": "standard",
    "cache_strategy": "anthropic_block"
  },
  "bedrock": {
    "endpoint": "https://bedrock-runtime.{region}.amazonaws.com/openai/v1",
    "default_model": "us.openai.gpt-5.6-sol",
    "env_keys": ["BEDROCK_API_KEY"],
    "reasoning_format": "none",
    "cache_strategy": "none",
    "auth": {"scheme": "sigv4", "service": "bedrock"}
  },
  "deepseek": {
    "endpoint": "https://api.deepseek.com/v1",
    "default_model": "deepseek-chat",
    "env_keys": ["DEEPSEEK_API_KEY"],
    "reasoning_format": "standard",
    "cache_strategy": "implicit"
  },
  "ollama": {
    "endpoint": "http://localhost:11434/v1",
    "default_model": "qwen2.5-coder:7b",
    "env_keys": [],
    "reasoning_format": "none",
    "cache_strategy": "none"
  },
  "lmstudio": {
    "endpoint": "http://localhost:1234/v1",
    "default_model": "qwen2.5-coder-7b-instruct",
    "env_keys": [],
    "reasoning_format": "standard",
    "cache_strategy": "none"
  },
  "vllm": {
    "endpoint": "http://localhost:8000/v1",
    "default_model": "qwen2.5-coder-7b-instruct",
    "env_keys": [],
    "reasoning_format": "standard",
    "cache_strategy": "none"
  },
  "llamacpp": {
    "endpoint": "http://localhost:8080/v1",
    "default_model": "local-model",
    "env_keys": [],
    "reasoning_format": "standard",
    "cache_strategy": "none"
  },
  "local": {
    "endpoint": "http://localhost:1234/v1",
    "default_model": "qwen2.5-coder-7b-instruct",
    "env_keys": [],
    "reasoning_format": "standard",
    "cache_strategy": "none"
  },
  "groq": {
    "endpoint": "https://api.groq.com/openai/v1",
    "default_model": "llama-3.3-70b-versatile",
    "env_keys": ["GROQ_API_KEY"],
    "reasoning_format": "standard",
    "cache_strategy": "none"
  }
}
